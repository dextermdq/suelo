{
  "name": "programa-pelvico",
  "version": "0.1.0",
  "type": "module",
  "description": "PWA para seguir programa de control pélvico de 12 semanas",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "dryrun": "node --loader tsx tools/dryrun.ts"
  },
  "dependencies": {
    "dexie": "^4.0.0",
    "js-yaml": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.0",
    "fast-check": "^3.14.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.0.0"
  },
  "packageManager": "pnpm@8.0.0"
}
